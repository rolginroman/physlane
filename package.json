{
  "name": "physlane",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "tsx scripts/build-content.ts && vite build",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src vite.config.ts vitest.config.ts drizzle.config.ts scripts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "e2e": "pnpm --filter @physlane/e2e test",
    "db:generate": "drizzle-kit generate",
    "stripe:fixtures": "stripe fixtures stripe/fixtures.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/mcp": "^1.7.10",
    "@better-auth/oauth-provider": "^1.7.10",
    "@fontsource-variable/geist": "^5.3.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.3",
    "better-auth": "^1.7.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.59.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.22.1",
    "stripe": "^23.0.0",
    "tailwindcss": "^4.1.18",
    "tele-better-auth": "^1.7.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@mdx-js/rollup": "^3.1.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "satori": "^0.62.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}
